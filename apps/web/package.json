{
  "name": "engvocab-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test",
    "test:e2e:db:up": "docker compose -f e2e/docker-compose.yml up -d --wait",
    "test:e2e:db:down": "docker compose -f e2e/docker-compose.yml down --volumes",
    "test:e2e:install": "playwright install chromium",
    "lighthouse": "lhci autorun",
    "lighthouse:summary": "node scripts/lighthouse/write-summary.mjs",
    "lighthouse:desktop": "lhci autorun --config=.lighthouserc.desktop.cjs",
    "lighthouse:desktop:summary": "node scripts/lighthouse/write-summary.mjs --report-directory .lighthouseci-desktop --profile desktop",
    "lighthouse:authenticated": "lhci autorun --config=.lighthouserc.authenticated.cjs",
    "lighthouse:authenticated:summary": "node scripts/lighthouse/write-summary.mjs --profile authenticated",
    "lighthouse:authenticated:assert": "node scripts/lighthouse/assert-budgets.mjs --profile authenticated",
    "lighthouse:authenticated:desktop": "lhci autorun --config=.lighthouserc.authenticated.desktop.cjs",
    "lighthouse:authenticated:desktop:summary": "node scripts/lighthouse/write-summary.mjs --profile authenticated-desktop",
    "lighthouse:authenticated:desktop:assert": "node scripts/lighthouse/assert-budgets.mjs --profile authenticated-desktop",
    "lighthouse:assert": "node scripts/lighthouse/assert-budgets.mjs",
    "lighthouse:desktop:assert": "node scripts/lighthouse/assert-budgets.mjs --profile desktop"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "puppeteer-core": "^24.31.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
