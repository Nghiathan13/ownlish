// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                 @id @default(uuid())
  email               String                 @unique
  passwordHash        String                 @map("password_hash")
  name                String?
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  collections         WordCollection[]
  refreshSessions     RefreshSession[]
  vocabWords          VocabWord[]
  toeicRuns           ToeicRun[]

  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model VocabWord {
  id             String @id @default(uuid())
  userId         String @map("user_id")
  word           String
  normalizedWord String @map("normalized_word")

  collectionItems CollectionUserWordItem[]
  definitions     VocabWordDefinition[]
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedWord])
  @@index([userId])
  @@map("vocab_words")
}

model VocabWordDefinition {
  id                 String    @id @default(uuid())
  vocabWordId        String    @map("vocab_word_id")
  sourceDefinitionId Int?      @map("source_definition_id")
  sourceWordId       Int?      @map("source_word_id")
  type               String?
  meaningVi          String?   @map("meaning_vi")
  definition         String?
  example            String?
  exampleVi          String?   @map("example_vi")
  ipaUk              String?   @map("ipa_uk")
  ipaUs              String?   @map("ipa_us")
  band               String?
  source             String    @default("manual")
  level              Int       @default(0)
  wrongCount         Int       @default(0) @map("wrong_count")
  lastReview         DateTime? @map("last_review")
  nextReview         DateTime? @map("next_review")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  vocabWord VocabWord @relation(fields: [vocabWordId], references: [id], onDelete: Cascade)

  @@unique([vocabWordId, source, sourceDefinitionId])
  @@index([vocabWordId])
  @@index([vocabWordId, deletedAt])
  @@index([deletedAt, level, nextReview])
  @@index([source, sourceDefinitionId])
  @@map("vocab_word_definitions")
}

enum WordCollectionKind {
  SYSTEM
  USER
}

model CatalogWord {
  id             String   @id @default(uuid())
  word           String
  normalizedWord String   @unique @map("normalized_word")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  collectionItems CollectionCatalogItem[]
  definitions     CatalogDefinition[]

  @@index([word])
  @@map("catalog_words")
}

model CatalogDefinition {
  id                 String   @id @default(uuid())
  catalogWordId      String   @map("catalog_word_id")
  sourceDefinitionId Int      @map("source_definition_id")
  sourceWordId       Int      @map("source_word_id")
  type               String
  meaningVi          String?  @map("meaning_vi")
  definition         String?
  example            String?
  exampleVi          String?  @map("example_vi")
  ipaUk              String?  @map("ipa_uk")
  ipaUs              String?  @map("ipa_us")
  band               String?
  source             String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  catalogWord CatalogWord @relation(fields: [catalogWordId], references: [id], onDelete: Cascade)

  @@unique([source, sourceDefinitionId])
  @@index([catalogWordId])
  @@index([source, band])
  @@map("catalog_definitions")
}

model WordCollection {
  id          String             @id @default(uuid())
  ownerUserId String?            @map("owner_user_id")
  name        String
  description String?
  kind        WordCollectionKind @default(USER)
  source      String?
  cefrLevel   String?            @map("cefr_level")
  isPublic    Boolean            @default(false) @map("is_public")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  catalogItems  CollectionCatalogItem[]
  owner         User?                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  userWordItems CollectionUserWordItem[]

  @@index([kind])
  @@index([ownerUserId])
  @@index([source, cefrLevel])
  @@map("word_collections")
}

model CollectionCatalogItem {
  collectionId  String @map("collection_id")
  catalogWordId String @map("catalog_word_id")
  sortOrder     Int    @default(0) @map("sort_order")

  catalogWord CatalogWord    @relation(fields: [catalogWordId], references: [id], onDelete: Cascade)
  collection  WordCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([collectionId, catalogWordId])
  @@index([catalogWordId])
  @@map("collection_catalog_items")
}

model CollectionUserWordItem {
  collectionId String @map("collection_id")
  vocabWordId  String @map("vocab_word_id")
  sortOrder    Int    @default(0) @map("sort_order")

  collection WordCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  vocabWord  VocabWord      @relation(fields: [vocabWordId], references: [id], onDelete: Cascade)

  @@id([collectionId, vocabWordId])
  @@index([vocabWordId])
  @@map("collection_user_word_items")
}

enum ToeicRunMode {
  PRACTICE
  WRONG_REVIEW
}

enum ToeicRunGroupStatus {
  RIGHT
  WRONG
}

enum ToeicRunQuestionStatus {
  SELECTED
  RIGHT
  WRONG
}

model ToeicTest {
  id         Int                @id @default(autoincrement())
  year       Int
  testNumber Int                @map("test_number")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  parts      ToeicTestPart[]
  toeicRuns  ToeicRun[]

  @@unique([year, testNumber])
  @@map("toeic_tests")
}

model ToeicTestPart {
  id         Int                  @id @default(autoincrement())
  testId     Int                  @map("test_id")
  partNumber Int                  @map("part_number")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  test       ToeicTest            @relation(fields: [testId], references: [id], onDelete: Cascade)
  groups     ToeicQuestionGroup[]

  @@unique([testId, partNumber])
  @@index([testId])
  @@map("toeic_test_parts")
}

model ToeicQuestionGroup {
  id               Int             @id @default(autoincrement())
  testPartId       Int             @map("test_part_id")
  questionStart    Int             @map("question_start")
  questionEnd      Int             @map("question_end")
  groupType        String?         @map("group_type")
  accent           String?
  content          String?
  contentVi        String?         @map("content_vi")
  audioStoragePath String?         @map("audio_storage_path")
  imageStoragePath String?         @map("image_storage_path")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  testPart         ToeicTestPart   @relation(fields: [testPartId], references: [id], onDelete: Cascade)
  questions        ToeicQuestion[]
  runGroups        ToeicRunGroup[]

  @@unique([testPartId, questionStart, questionEnd])
  @@index([testPartId])
  @@map("toeic_question_groups")
}

model ToeicQuestion {
  id              Int                   @id @default(autoincrement())
  groupId         Int                   @map("group_id")
  questionNumber  Int                   @map("question_number")
  question        String?
  questionVi      String?               @map("question_vi")
  questionType    String?               @map("question_type")
  optionA         String?               @map("option_a")
  optionB         String?               @map("option_b")
  optionC         String?               @map("option_c")
  optionD         String?               @map("option_d")
  optionAVi       String?               @map("option_a_vi")
  optionBVi       String?               @map("option_b_vi")
  optionCVi       String?               @map("option_c_vi")
  optionDVi       String?               @map("option_d_vi")
  answerKey       String?               @map("answer_key")
  explanationVi   String?               @map("explanation_vi")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  group           ToeicQuestionGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  runQuestions    ToeicRunQuestion[]

  @@unique([groupId, questionNumber])
  @@index([groupId])
  @@map("toeic_questions")
}

model ToeicRun {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  toeicTestId          Int                @map("toeic_test_id")
  mode                 ToeicRunMode       @default(PRACTICE)
  selectedParts        Int[]              @map("selected_parts")
  currentQuestionIndex Int                @default(0) @map("current_question_index")
  totalRight           Int                @default(0) @map("total_right")
  totalWrong           Int                @default(0) @map("total_wrong")
  createdAt            DateTime           @default(now()) @map("created_at")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  test                 ToeicTest          @relation(fields: [toeicTestId], references: [id], onDelete: Cascade)
  groups               ToeicRunGroup[]
  questions            ToeicRunQuestion[]

  @@index([userId])
  @@index([userId, toeicTestId, mode, createdAt])
  @@index([toeicTestId])
  @@map("toeic_runs")
}

model ToeicRunGroup {
  id                   String               @id @default(uuid())
  runId                String               @map("run_id")
  toeicQuestionGroupId Int                  @map("toeic_question_group_id")
  partNumber           Int                  @map("part_number")
  questionStart        Int                  @map("question_start")
  questionEnd          Int                  @map("question_end")
  sortOrder            Int                  @map("sort_order")
  status               ToeicRunGroupStatus?
  run                  ToeicRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  toeicQuestionGroup   ToeicQuestionGroup   @relation(fields: [toeicQuestionGroupId], references: [id], onDelete: Cascade)
  questions            ToeicRunQuestion[]

  @@unique([runId, toeicQuestionGroupId])
  @@unique([runId, sortOrder])
  @@index([runId])
  @@index([runId, status])
  @@index([runId, partNumber])
  @@index([toeicQuestionGroupId])
  @@map("toeic_run_groups")
}

model ToeicRunQuestion {
  id              String                  @id @default(uuid())
  runId           String                  @map("run_id")
  runGroupId      String                  @map("run_group_id")
  toeicQuestionId Int                     @map("toeic_question_id")
  partNumber      Int                     @map("part_number")
  questionNumber  Int                     @map("question_number")
  sortOrder       Int                     @map("sort_order")
  selectedKey     String?                 @map("selected_key")
  status          ToeicRunQuestionStatus?
  answeredAt      DateTime?               @map("answered_at")
  gradedAt        DateTime?               @map("graded_at")
  run             ToeicRun                @relation(fields: [runId], references: [id], onDelete: Cascade)
  runGroup        ToeicRunGroup           @relation(fields: [runGroupId], references: [id], onDelete: Cascade)
  toeicQuestion   ToeicQuestion           @relation(fields: [toeicQuestionId], references: [id], onDelete: Cascade)

  @@unique([runId, toeicQuestionId])
  @@unique([runId, sortOrder])
  @@index([runId])
  @@index([runId, status])
  @@index([runGroupId])
  @@index([runGroupId, status])
  @@index([toeicQuestionId])
  @@map("toeic_run_questions")
}
