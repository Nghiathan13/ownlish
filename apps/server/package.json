{
  "name": "engvocab-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test,performance}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test,performance}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "admin:grant": "ts-node scripts/grant-admin.ts",
    "toeic:catalog": "ts-node scripts/build-toeic-catalog.ts",
    "toeic:publish": "ts-node scripts/publish-toeic-catalog.ts",
    "performance:seed": "ts-node performance/seed.ts",
    "performance:seed:baseline": "PERFORMANCE_VUS=10 pnpm performance:seed",
    "performance:seed:moderate": "PERFORMANCE_VUS=25 pnpm performance:seed",
    "lighthouse:seed": "PERFORMANCE_VUS=1 ts-node scripts/seed-lighthouse-fixture.ts",
    "performance:run": "mkdir -p test-results/performance && docker run --rm --user \"$(id -u):$(id -g)\" --network host -v \"$PWD:/work\" -w /work -e PERFORMANCE_BASE_URL -e PERFORMANCE_EMAIL_PREFIX -e PERFORMANCE_PASSWORD -e PERFORMANCE_PROFILE grafana/k6:1.7.1 run --summary-trend-stats 'med,p(95),p(99),count' /work/performance/core-api.js",
    "performance:run:baseline": "PERFORMANCE_PROFILE=baseline pnpm performance:run",
    "performance:run:moderate": "PERFORMANCE_PROFILE=moderate pnpm performance:run",
    "performance:cleanup": "ts-node performance/cleanup.ts",
    "performance:summary": "node performance/summary.mjs",
    "performance:baseline:update": "node performance/update-baseline.mjs",
    "performance:test": "node --test performance/*.test.mjs",
    "performance:grading-index": "node performance/serve-grading-index.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.0",
    "@supabase/supabase-js": "^2.49.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
