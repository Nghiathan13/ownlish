# Keep the real file at /opt/ownlish/env/production.env. Never commit it.
OWNLISH_ENV=production
POSTGRES_USER=ownlish
POSTGRES_PASSWORD=replace-with-a-unique-production-password
POSTGRES_DB=ownlish
DATABASE_URL=postgresql://ownlish:replace-with-a-unique-production-password@postgres:5432/ownlish
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters

PORT=3001
CORS_ORIGIN=https://ownlish.com
REFRESH_TOKEN_COOKIE_NAME=ownlish.refreshToken
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAME_SITE=lax

NEXT_PUBLIC_API_BASE_URL=https://api.ownlish.com
AUTH_API_BASE_URL=http://ownlish-production-server:3001
NEXT_PUBLIC_TOEIC_CATALOG_ROOT=https://content.ownlish.com/toeic
NEXT_PUBLIC_DICTATION_CATALOG_ROOT=https://content.ownlish.com/dictation
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ownlish.com

R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CONTENT_BUCKET=ownlish-content-prod
R2_ASSETS_BUCKET=ownlish-assets-prod
PUBLIC_ASSETS_ROOT=https://assets.ownlish.com
TOEIC_GRADING_INDEX_URL=https://content.ownlish.com/toeic/grading-index.json

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=ownlish-server

# Used only by the host backup scripts, never by the application containers.
R2_BACKUPS_BUCKET=ownlish-backups-prod
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
