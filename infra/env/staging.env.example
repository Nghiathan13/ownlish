# Keep the real file at /opt/ownlish/env/staging.env. Never commit it.
OWNLISH_ENV=staging
POSTGRES_USER=ownlish
POSTGRES_PASSWORD=replace-with-a-unique-staging-password
POSTGRES_DB=ownlish
DATABASE_URL=postgresql://ownlish:replace-with-a-unique-staging-password@postgres:5432/ownlish
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters

PORT=3001
CORS_ORIGIN=https://staging.ownlish.com
REFRESH_TOKEN_COOKIE_NAME=ownlish.refreshToken
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAME_SITE=lax

NEXT_PUBLIC_API_BASE_URL=https://api.staging.ownlish.com
AUTH_API_BASE_URL=http://ownlish-staging-server:3001
NEXT_PUBLIC_TOEIC_CATALOG_ROOT=https://content.staging.ownlish.com/toeic
NEXT_PUBLIC_DICTATION_CATALOG_ROOT=https://content.staging.ownlish.com/dictation
NEXT_PUBLIC_DICTIONARY_ROOT=https://content.staging.ownlish.com/dictionary
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
RESEND_API_KEY=
EMAIL_FROM="Ownlish <auth@ownlish.com>"
EMAIL_OTP_PEPPER=replace-with-a-unique-secret-of-at-least-32-characters

R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CONTENT_BUCKET=ownlish-content-staging
R2_ASSETS_BUCKET=ownlish-assets-staging
PUBLIC_ASSETS_ROOT=https://assets.staging.ownlish.com
TOEIC_GRADING_INDEX_URL=https://content.staging.ownlish.com/toeic/grading-index.json

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=ownlish-server-staging
