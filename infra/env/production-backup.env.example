# Keep the real file at /opt/ownlish/env/production-backup.env with mode 0600.
# This file is read only by the host backup script, never application containers.
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_BACKUPS_BUCKET=ownlish-backups-prod
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
